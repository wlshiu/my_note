 #include "../common/jtag.h"
 #include "../common/uart.h"
 
+/* 16-Pin IOPAD 腳位映射定義 (與 MuraxSysCtrlPinMux 一致) */
+#define PIN_UART_TXD    0
+#define PIN_UART_RXD    1
+#define PIN_I2C_SCL     2
+#define PIN_I2C_SDA     3
+#define PIN_SPI_SS0     4
+#define PIN_SPI_SCLK    5
+#define PIN_SPI_MOSI    6
+#define PIN_SPI_MISO    7
+#define PIN_JTAG_TMS    12
+#define PIN_JTAG_TCK    13
+#define PIN_JTAG_TDI    14
+#define PIN_JTAG_TDO    15
+
+/* =========================================================================
+ * 16-Pin IOPAD 虛擬電路板連線、SPI Loopback & 虛擬 I2C Slave 模擬元件
+ * ========================================================================= */
+class SpiI2cSimProcess : public TimeProcess {
+public:
+    VMurax *top;
+
+    /* 虛擬電路板訊號線 (供 UartRx / UartTx / Jtag 類別綁定指標) */
+    CData pin_uart_txd = 1;
+    CData pin_uart_rxd = 1;
+    CData pin_jtag_tms = 1;
+    CData pin_jtag_tdi = 1;
+    CData pin_jtag_tdo = 1;
+    CData pin_jtag_tck = 0;
+
+    uint8_t dev_addr = 0x50;   // 虛擬 I2C Slave 7-bit 位址
+    uint8_t reg_data = 0x5A;   // 預設暫存器內容
+    uint8_t prev_scl = 1;
+    uint8_t prev_sda = 1;
+    int bit_cnt = 0;
+    uint8_t shift_reg = 0;
+    bool active = false;
+    bool is_read = false;
+    bool addr_phase = true;
+    bool master_nacked = false; // 新增：記錄 Master 是否已送出 NACK
+    uint8_t slave_sda_out = 1;
+
+    SpiI2cSimProcess(VMurax *top) : top(top) {
+        // 初始化外部上拉與 MISO 預設狀態
+        top->io_iopad_read = 0xFFFF;
+        schedule(0);
+    }
+
+    virtual void tick() {
+        uint16_t out_val = top->io_iopad_write;
+        uint16_t out_en  = top->io_iopad_writeEnable;
+        uint16_t in_val  = 0xFFFF; // 預設外部弱上拉為 1
+
+        // 1. UART 腳位轉接 (Pin 0 = TXD, Pin 1 = RXD)
+        pin_uart_txd = ((out_en >> PIN_UART_TXD) & 1) ? ((out_val >> PIN_UART_TXD) & 1) : 1;
+        if (pin_uart_rxd) in_val |= (1 << PIN_UART_RXD);
+        else              in_val &= ~(1 << PIN_UART_RXD);
+
+        // 2. I2C Open-Drain 線與邏輯 (Master 輸出與 Slave 輸出做 AND，模擬外部上拉電阻)
+        // SoC 主動拉低條件: out_en == 1 且 out_val == 0
+        bool soc_scl_low = ((out_en >> PIN_I2C_SCL) & 1) && !((out_val >> PIN_I2C_SCL) & 1);
+        bool soc_sda_low = ((out_en >> PIN_I2C_SDA) & 1) && !((out_val >> PIN_I2C_SDA) & 1);
+
+        uint8_t bus_scl = soc_scl_low ? 0 : 1;
+        uint8_t bus_sda = (soc_sda_low ? 0 : 1) & (slave_sda_out & 1);
+
+        if (bus_scl) in_val |= (1 << PIN_I2C_SCL); else in_val &= ~(1 << PIN_I2C_SCL);
+        if (bus_sda) in_val |= (1 << PIN_I2C_SDA); else in_val &= ~(1 << PIN_I2C_SDA);
+
+        // 3. SPI Loopback：直接將 Pin 6 (MOSI) 接回 Pin 7 (MISO)
+        bool spi_mosi = ((out_en >> PIN_SPI_MOSI) & 1) ? ((out_val >> PIN_SPI_MOSI) & 1) : 1;
+        if (spi_mosi) in_val |= (1 << PIN_SPI_MISO);
+        else          in_val &= ~(1 << PIN_SPI_MISO);
+
+        // 4. JTAG 腳位轉接 (Pin 12=TMS, Pin 13=TCK, Pin 14=TDI, Pin 15=TDO)
+        if (pin_jtag_tms) in_val |= (1 << PIN_JTAG_TMS); else in_val &= ~(1 << PIN_JTAG_TMS);
+        if (pin_jtag_tck) in_val |= (1 << PIN_JTAG_TCK); else in_val &= ~(1 << PIN_JTAG_TCK);
+        if (pin_jtag_tdi) in_val |= (1 << PIN_JTAG_TDI); else in_val &= ~(1 << PIN_JTAG_TDI);
+        pin_jtag_tdo = ((out_en >> PIN_JTAG_TDO) & 1) ? ((out_val >> PIN_JTAG_TDO) & 1) : 1;
+
+        // 回寫 16-bit 輸入狀態至 SoC
+        top->io_iopad_read = in_val;
+
+        // 5. 虛擬 I2C Slave 狀態機
+        if (bus_scl == 1 && prev_scl == 1 && prev_sda == 1 && bus_sda == 0) {
+            // 偵測 START
+            active = true;
+            addr_phase = true;
+            master_nacked = false;
+            bit_cnt = 0;
+            shift_reg = 0;
+            slave_sda_out = 1;
+        } else if (bus_scl == 1 && prev_scl == 1 && prev_sda == 0 && bus_sda == 1) {
+            // 偵測 STOP
+            active = false;
+            master_nacked = false;
+            slave_sda_out = 1;
+        } else if (active && prev_scl == 1 && bus_scl == 0) {
+            // SCL 負緣更新 SDA 輸出
+            if (master_nacked) {
+                slave_sda_out = 1; // Master 已回 NACK，Slave 釋放匯流排等待 STOP
+            } else if (bit_cnt < 8) {
+                slave_sda_out = (is_read && !addr_phase) ? ((reg_data >> (7 - bit_cnt)) & 0x01) : 1;
+            } else if (bit_cnt == 8) {
+                if (is_read && !addr_phase) {
+                    slave_sda_out = 1; // 釋放 SDA 讓 Master 送 ACK/NACK
+                } else {
+                    if (!addr_phase || ((shift_reg >> 1) == dev_addr)) {
+                        slave_sda_out = 0; // 回應 ACK
+                        if (addr_phase) is_read = (shift_reg & 0x01);
+                        else reg_data = shift_reg;
+                    } else {
+                        slave_sda_out = 1; // 位址不符回 NACK
+                    }
+                }
+            } else {
+                bit_cnt = 0;
+                addr_phase = false;
+                slave_sda_out = is_read ? ((reg_data >> 7) & 0x01) : 1;
+            }
+        } else if (active && prev_scl == 0 && bus_scl == 1) {
+            // SCL 正緣取樣資料
+            if (bit_cnt < 8) {
+                shift_reg = (shift_reg << 1) | (bus_sda & 0x01);
+            } else if (bit_cnt == 8 && is_read && !addr_phase) {
+                // 取樣 Master 在讀取階段回應的 ACK(0) 或 NACK(1)
+                if (bus_sda == 1) {
+                    master_nacked = true;
+                }
+            }
+            bit_cnt++;
+        }
+
+        prev_scl = bus_scl;
+        prev_sda = bus_sda;
+
+        // 每半個 32MHz mainClk 週期 (15625 ps) 更新一次取樣
+        schedule(15625);
+    }
+};
+
