    <coordinates>
      <x>275</x>
      <y>748</y>
      <w>693</w>
      <h>187</h>
    </coordinates>
    <panel_attributes>+ GNU is the ground of PCBA
+ Earth is the global ground
+ C_g is the capacitance between PCBA and Earth ground
+ C_x is the equivalent-parasitic capacitances of touch device
+ C_p is the equivalent-parasitic capacitances of PCBA
+ C_s is the sampled capacitance
+ C_t is the equivalent capacitance between Human finger and Touch Electrode
+ C_h is the equivalent capacitance of Human body
fontsize=16
layer=1</panel_attributes>
    <additional_attributes/>
